{
  "name": "@eduwork/dsh-calendar",
  "version": "0.1.0-dev",
  "description": "Sidebar week/month calendar with drag-to-create, reminders and ICS import; local data only.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MulanPSL-2.0 AND MIT",
  "exports": {
    ".": "./lib/index.js",
    "./tools": "./lib/tools.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./remote": "./lib/typert.remote-client.js",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/**/*",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "MARKET.md",
    "docs/**/*",
    "skills/**/*"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1 <0.3.0"
  },
  "keywords": [
    "calendar",
    "schedule",
    "reminder",
    "ics"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <4.1.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.5-rc.1 <0.2.2",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.5-rc.2 <0.2.2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-rc.1 <0.2.2",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.2-rc.1 <0.2.2",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.2-rc.1 <0.2.2",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.5-rc.1 <0.2.2",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1 <0.2.2",
    "@deepseek-ai/dsh-permission-presets": ">=0.1.5-rc.1 <0.2.2",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.5-rc.1 <0.2.2",
    "react": "^18.2.0",
    "zod": "^4.4.3"
  }
}
